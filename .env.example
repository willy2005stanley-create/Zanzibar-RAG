# Copy this file to .env and fill in your key. Never commit the real .env file.
GROQ_API_KEY= 'YOUR_GROQ_API_KEY_HERE'

# Optional: override the Groq model. Groq periodically retires models —
# if you see a 404 "model_not_found" error, check console.groq.com/docs/models
# for the current name and set it here instead of editing the code.
GROQ_MODEL=openai/gpt-oss-120b
